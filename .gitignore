# macOS
.DS_Store

# Dropbox sync artifacts
*conflicted copy*
.dropbox
.dropbox.cache

# editors / python
*.swp
.vscode/
__pycache__/

# Raw downloads waiting to be turned into documents. Emptied as they are
# processed; every one of them is re-downloadable (see handbook/TRACT-RESEARCH.md).
inbox/

# One folder per document (documents/<id>/) holds everything about it. The
# heavy, re-derivable parts stay out of git; the reasoning does not.
#   ignored: the source scan (re-downloadable) and renders (regenerate by
#            running utilities/new-map.command over the scan again)
#   tracked: the document file, the alignment (a HAND fit — not reproducible
#            by anyone but Kenny at the tool), the Part A transcription, and
#            any notes
# If viewer-facing map overlays ever land, the web-sized derivative to commit
# should be named <id>-web.jpg and added as an exception here.
documents/*/*.pdf
documents/*/*-100dpi.png
documents/*/*-overlay.png
documents/*/*-only-*.png

# Written into utilities/ by the start-*.command launchers each time they serve
# the folder, so the tools can name the folder you have to connect. It records
# THIS machine's path.
project-info.json

# tests/preview-test.js stands a local Leaflet in for the CDN copy.
node_modules/

# Where instances put files they aren't allowed to delete; Kenny empties it.
# Its contents were committed by accident once, so it stays out of git.
_to_delete/
