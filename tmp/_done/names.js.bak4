        url: "https://lastreetnames.com/street/grand-avenue/" },
      { title: "Wikipedia: Grand Avenue (Los Angeles) — renamed Feb. 15, 1887",
        url: "https://en.wikipedia.org/wiki/Grand_Avenue_(Los_Angeles)" }
